---
import { strings, pathFor, LANGS, type Lang } from '../i18n/strings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const label = (l: Lang) => (l === 'zh' ? '中' : 'EN');
const htmlLang = (l: Lang) => strings[l].htmlLang;
---
<nav class="nav glass" aria-label="SmallYuan">
  <a class="me" href={pathFor(lang)}>SmallYuan</a>
  <div class="seg" role="group" aria-label={t.langGroupLabel}>
    {LANGS.map((l) => (
      <a href={pathFor(l)} hreflang={htmlLang(l)} lang={htmlLang(l)} data-lang-choice={l} aria-current={l === lang ? 'page' : undefined}>{label(l)}</a>
    ))}
  </div>
</nav>
{lang === 'zh' && (
  <div class="lang-hint glass" data-lang-hint role="status" hidden>
    <span>{strings.zh.langHint}</span>
    <a href="/en/" lang="en" data-lang-choice="en">{strings.zh.langHintGo}</a>
    <button type="button" data-lang-dismiss>{strings.zh.langHintDismiss}</button>
  </div>
)}

<script>
  import { initLang } from '../scripts/lang';
  initLang(document);
</script>

<style>
  .nav { position: sticky; top: max(12px, env(safe-area-inset-top)); z-index: 2; display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 8px 8px 18px; border-radius: var(--r-pill); }
  .me { font: 600 15px var(--f-display); letter-spacing: -0.01em; text-decoration: none; }
  .seg { display: flex; padding: 3px; border-radius: var(--r-pill); background: rgba(0, 0, 0, 0.25); font: 500 13px var(--f-display); }
  .seg a { padding: 5px 12px; border-radius: var(--r-pill); color: var(--dim); text-decoration: none; }
  .seg a[aria-current='page'] { background: rgba(255, 255, 255, 0.18); color: var(--fg); box-shadow: inset 0 1px 0 var(--hi); }
  /* Floats over the page: it appears after scripts run, so being in the flow would shift everything below (CLS) */
  .lang-hint { position: fixed; z-index: 3; left: 50%; bottom: max(16px, env(safe-area-inset-bottom)); transform: translateX(-50%); width: max-content; max-width: calc(100% - 32px); display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; padding: 10px 16px; border-radius: var(--r-lg); font-size: 14px; color: var(--soft); }
  .lang-hint[hidden] { display: none; }
  .lang-hint a { color: var(--fg); font-weight: 500; }
  .lang-hint button { margin-left: auto; font: 500 13px var(--f-display); color: var(--dim); background: none; border: 0; cursor: pointer; }
</style>
