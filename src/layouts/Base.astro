---
import '../styles/tokens.css';
import '../styles/global.css';
import { strings, pathFor, type Lang } from '../i18n/strings';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = strings[lang];
const site = Astro.site ?? new URL('https://smallyuan.dev');
const abs = (l: Lang) => new URL(pathFor(l), site).href;
---
<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <link rel="canonical" href={abs(lang)} />
    <link rel="alternate" hreflang="zh-Hant" href={abs('zh')} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="x-default" href={abs('zh')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:url" content={abs(lang)} />
    <meta property="og:locale" content={t.ogLocale} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0b0d12" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Inter+Tight:wght@500;600;700&family=Noto+Sans+TC:wght@400;500;700&display=swap" />
  </head>
  <body>
    <div class="bg" aria-hidden="true"><span class="blob b1"></span><span class="blob b2"></span><span class="blob b3"></span></div>
    <main class="page"><slot /></main>
  </body>
</html>
